//
//  Secrets.xcconfig.example
//  OpenUIGen
//
//  Copy this file to Secrets.xcconfig and fill in the real values.
//  Secrets.xcconfig is gitignored and must never be committed.
//
//      cp ios/OpenUIGen/Application/Resources/Secrets.xcconfig.example \
//         ios/OpenUIGen/Application/Resources/Secrets.xcconfig
//
//  List every key the app expects here, so the next person knows what they need
//  without having to read the code.

// The openui-gen backend (`make backend` at the repo root, port 8080).
// xcconfig treats `//` as the start of a comment, so the scheme separator is written
// `/$()/`: the empty `$()` expands to nothing and the value becomes http://127.0.0.1:8080.
// The simulator reaches the Mac at 127.0.0.1. A device needs the Mac's LAN address
// (`ipconfig getifaddr en0`), e.g. http:/$()/192.168.1.20:8080.
API_BASE_URL = http:/$()/127.0.0.1:8080
