  "deviations": [
    {
      "primitive": "Button",
      "prop": "height",
      "atomize": 40,
      "groundRule": 44,
      "why": "controls are 44"
    },
    {
      "primitive": "Button",
      "prop": "paddingX",
      "atomize": 10,
      "groundRule": 16,
      "why": "button padding 16"
    },
    {
      "primitive": "Button",
      "prop": "radius",
      "atomize": 10,
      "groundRule": 12,
      "why": "radii 8/12 for buttons; 10 is not allowed"
    },
    {
      "primitive": "Button",
      "prop": "label type",
      "atomize": "UI/body-1/medium 13/24 Open Sauce Two",
      "groundRule": "body 16/20 medium SF Pro",
      "why": "type scale and family"
    },
    {
      "primitive": "Button",
      "prop": "icon",
      "atomize": 18,
      "groundRule": 16,
      "why": "inline icons 16"
    },
    {
      "primitive": "IconButton",
      "prop": "shape",
      "atomize": "rounded square, radius 10, 40",
      "groundRule": "round, 44",
      "why": "icon buttons fully round, 44 tap target"
    },
    {
      "primitive": "Badge",
      "prop": "radius",
      "atomize": 8,
      "groundRule": 4,
      "why": "static badges radius 4"
    },
    {
      "primitive": "Badge",
      "prop": "height / paddingX",
      "atomize": "28 / 6",
      "groundRule": "24 / 8",
      "why": "8-grid"
    },
    {
      "primitive": "Chip",
      "prop": "radius",
      "atomize": "8 (sm) / 10 (md)",
      "groundRule": "pill",
      "why": "selections are pills"
    },
    {
      "primitive": "Chip",
      "prop": "paddingX",
      "atomize": 8,
      "groundRule": 12,
      "why": "spacing scale"
    },
    {
      "primitive": "SegmentedControl",
      "prop": "height / item radius",
      "atomize": "40 / 10",
      "groundRule": "44 / pill",
      "why": "controls 44, selections pills"
    },
    {
      "primitive": "IconTile",
      "prop": "size / radius",
      "atomize": "48 / 10",
      "groundRule": "40 or 56 / 12",
      "why": "avatar sizes 20·40·56·80; radius 12"
    },
    {
      "primitive": "IconTile",
      "prop": "icon",
      "atomize": 28,
      "groundRule": 24,
      "why": "icon 24 in tiles"
    },
    {
      "primitive": "Card",
      "prop": "radius / padding",
      "atomize": "28 / 8",
      "groundRule": "24 / 16",
      "why": "containers radius 24, padding 16"
    },
    {
      "primitive": "Row",
      "prop": "type",
      "atomize": "UI/para/medium 13/20, caption-2 12/16",
      "groundRule": "body 16/20, footnote 14/18",
      "why": "type scale"
    },
    {
      "primitive": "Note",
      "prop": "type",
