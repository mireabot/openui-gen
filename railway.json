{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/src/**",
      "/preview/**",
      "/catalog/**",
      "/design/**",
      "/package*.json",
      "/tsconfig*.json",
      "/Dockerfile",
      "/.dockerignore",
      "/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node dist/src/server.js",
    "healthcheckPath": "/health"
  }
}
