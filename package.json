{
  "name": "openui-gen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenUI Lang generation for sports screens, with a preview.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "preview": "npm --prefix preview run dev",
    "preview:build": "npm --prefix preview run build",
    "openui:export": "node --import tsx scripts/export-openui.ts",
    "check:templates": "node --import tsx scripts/check-templates.ts",
    "sf-symbols": "tsx scripts/sf-symbols.ts",
    "ask": "node --import tsx scripts/ask.ts",
    "check:closure": "node --import tsx scripts/check-closure.ts",
    "check:compiler": "node --import tsx scripts/check-compiler.ts",
    "check:anthropic": "node --import tsx scripts/check-anthropic.ts",
    "check:lang": "node --import tsx scripts/check-lang.ts",
    "check:fotmob-feeds": "node --import tsx scripts/check-fotmob-feeds.ts",
    "check:feeds": "node --import tsx scripts/check-feeds.ts",
    "check:team-sports": "node --import tsx scripts/check-team-sports.ts",
    "catalog:samples": "node --import tsx scripts/build-catalog-samples.ts",
    "record:espn": "node --import tsx scripts/record-espn.ts",
    "check:all": "npm run typecheck && npm run check:feeds && npm run catalog:samples -- --check && npm run check:team-sports && npm run check:fotmob-feeds && npm run check:closure && npm run check:compiler && npm run check:anthropic && npm run check:codex && npm run check:lang && npm run check:sports && npm run check:writer-relevance && npm run check:recent-scorers && npm run check:players && npm run check:sports-catalog && npm run check:contract-names && npm run check:templates && npm run openui:export -- --check",
    "check:sports": "node --import tsx scripts/check-sports.ts",
    "check:writer-relevance": "node --import tsx scripts/check-writer-relevance.ts",
    "check:contract-names": "node --import tsx scripts/check-contract-names.ts",
    "probe:writer": "node --import tsx scripts/check-writer-relevance.ts --live",
    "check:sports-catalog": "node --import tsx scripts/check-sports-catalog.ts",
    "check:players": "node --import tsx scripts/check-player-images.ts",
    "check:recent-scorers": "node --import tsx scripts/check-recent-scorers.ts",
    "check:codex": "node --import tsx scripts/check-codex.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@hono/node-server": "^1.19.9",
    "@openuidev/lang-core": "1.0.0",
    "ajv": "^8.20.0",
    "hono": "^4.13.8",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
