# Copy to .env. .env is gitignored; this file is not.

## Models
# Claude on the Anthropic API writes screens, plans questions and extracts facts. Without
# LLM_PROVIDER, a set ANTHROPIC_API_KEY selects it; otherwise everything runs on OpenRouter.
ANTHROPIC_API_KEY=...
# LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5

# OpenRouter: always used for search planning; the writer and planner too when not on Anthropic.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-opus-5
OPENROUTER_SUMMARY_MODEL=anthropic/claude-haiku-5.5
# Cited web research: model and search engine (parallel | exa | perplexity | firecrawl | native | auto).
OPENROUTER_SEARCH_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_SEARCH_ENGINE=parallel

## Web research
# "parallel" (Parallel Search API + Haiku reads the pages) or "openrouter" (the search model's own tool).
WEB_RESEARCH_PROVIDER=parallel
# https://platform.parallel.ai. Without it, research uses OpenRouter.
PARALLEL_API_KEY=...

## Market data
# Massive: https://massive.com/dashboard/keys. MASSIVE_RPM is the plan's limit per minute (free: 5).
MASSIVE_API_KEY=...
MASSIVE_RPM=5
# Financial Modeling Prep: fallback when Massive fails or lacks a record, and company logos.
FMP_API_KEY=...

## State
# Dataset snapshots (/tools/stocks_dataset) and saved documents (follow-ups) live under DATA_DIR,
# with the Massive/FMP cache at MASSIVE_CACHE_DIR. Mount a volume here in deployment.
DATA_DIR=data
MASSIVE_CACHE_DIR=data/massive-cache
# One JSON per generation (steps, usage, cost, artifacts).
TRACE_ENABLED=false
TRACE_DIR=traces

## Server
PORT=8080
LOG_LEVEL=info
# Extra browser origins for the API, comma-separated. localhost is always allowed; the bundled
# preview is same-origin.
CORS_ORIGINS=
