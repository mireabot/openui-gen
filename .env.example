# Copy to .env. .env is gitignored; this file is not.

## Models
# Haiku understands the request, Sonnet reads each parallel search's pages into cited facts, Opus
# shapes the dataset and writes the screen.
# debug (default): those stages run through your Claude Code login, on your plan's limits.
# api: they run on the Anthropic API and bill ANTHROPIC_API_KEY. Parallel search bills in both modes.
# GENERATION_MODE=debug
ANTHROPIC_API_KEY=...
# SPORTS_PLAN_MODEL=claude-haiku-5-5
# SPORTS_SEARCH_MODEL=claude-sonnet-5-5
# SPORTS_MODEL=claude-opus-5-5

## Football data
# mixed (default): ESPN for tables, matches and clubs, FotMob for players.
# fotmob: FotMob for all of it, so clubs outside ESPN's six competitions get a crest and colour.
# FotMob's terms forbid automated retrieval: personal research only, never a deployment.
# DATA_SOURCE=mixed

## Web research
# https://platform.parallel.ai: Search finds and Extract reads the pages for each research question.
PARALLEL_API_KEY=...
# PARALLEL_SEARCH_MODE=advanced
# ESPN's public site API (scoreboards, teams, tables, team schedules) needs no key.
# ESPN_BASE_URL=https://site.api.espn.com/apis

## State
# Dataset snapshots (/tools/sports_dataset) and saved documents live under DATA_DIR. Mount a volume
# here in deployment.
DATA_DIR=data
# One JSON per generation (steps, usage, cost, artifacts).
TRACE_ENABLED=false
TRACE_DIR=traces

## Server
PORT=8080
LOG_LEVEL=info
# Extra browser origins for the API, comma-separated. localhost is always allowed; the bundled
# preview is same-origin.
CORS_ORIGINS=
